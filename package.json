{
  "name": "yolog",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "node -e \"if (!process.env.CI) { require('child_process').execSync('lefthook install', { stdio: 'inherit' }); }\"",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check",
    "typecheck": "astro check && tsc --noEmit",
    "test": "node --test --test-reporter=spec tests/unit/*.test.mjs",
    "verify:site": "node --env-file-if-exists=.env --test --test-reporter=spec tests/site/*.test.mjs",
    "validate": "bun run check && bun run typecheck && bun run test && bun run build && bun run verify:site"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "astro": "^7.4.7",
    "baseline-browser-mapping": "^2.11.35",
    "caniuse-lite": "^1.0.30001823",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.2",
    "lucide-react": "^1.70.0",
    "medium-zoom": "1.1.2",
    "mermaid": "^12.3.0",
    "nanostores": "^1.5.5",
    "plaiceholder": "3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@shikijs/transformers": "^4.6.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lefthook": "^2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "remark-breaks": "4.0.0",
    "remark-directive": "4.0.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.2.0"
  },
  "overrides": {
    "minimatch@10": "^10.2.6",
    "path-to-regexp@6": "^6.3.0",
    "path-to-regexp@8": "^8.4.2",
    "tar": "^7.5.22",
    "zod@4.1.11": "^4.6.6"
  },
  "packageManager": "bun@1.4.4"
}

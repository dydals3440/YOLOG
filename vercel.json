{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "installCommand": "npx --yes --allow-scripts=bun bun@1.4.4 install --frozen-lockfile",
  "buildCommand": "npx --yes --allow-scripts=bun bun@1.4.4 run build",
  "ignoreCommand": "[ \"$VERCEL_ENV\" = production ] && exit 1; curl -fsS \"https://api.github.com/repos/$VERCEL_GIT_REPO_OWNER/$VERCEL_GIT_REPO_SLUG/pulls?state=open&base=$VERCEL_GIT_COMMIT_REF\" | grep -q '\"number\"'",
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

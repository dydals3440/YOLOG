{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "installCommand": "npx --yes --allow-scripts=bun bun@1.4.4 ci",
  "buildCommand": "npx --yes --allow-scripts=bun bun@1.4.4 run build",
  "ignoreCommand": "[ \"$VERCEL_ENV\" = production ] && exit 1; curl -fsS \"https://api.github.com/repos/$VERCEL_GIT_REPO_OWNER/$VERCEL_GIT_REPO_SLUG/pulls?state=open&base=$VERCEL_GIT_COMMIT_REF\" | grep -q '\"number\"'",
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "redirects": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    },
    {
      "source": "/blogs/page/:page",
      "destination": "/blogs/:page",
      "statusCode": 301
    },
    {
      "source": "/blogs/:category/page/:page",
      "destination": "/blogs/:category/:page",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}

---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  // MDX는 불린 속성을 빈 문자열로 넘기므로 값이 아니라 존재 여부로 판단한다.
  priority?: string | boolean | undefined;
}

// 본문 최대 폭(--container-content)과, 세로로 긴 캡처가 한 화면 안에 들어오는 최대 높이
const CONTENT_MAX_WIDTH = 680;
const MAX_DISPLAY_HEIGHT = 720;

const { src, alt, priority } = Astro.props;
const width = Math.min(
  src.width,
  CONTENT_MAX_WIDTH,
  Math.round((MAX_DISPLAY_HEIGHT * src.width) / src.height),
);
const isPriority = priority !== undefined && priority !== false;
const hasCaption = alt !== "" && !/^\d/.test(alt);
---

<figure class="post-image">
  <div class="block overflow-hidden">
    <Image src={src} alt={alt} width={width} priority={isPriority} />
  </div>
  {hasCaption && <figcaption class="w-full text-center">{alt}</figcaption>}
</figure>

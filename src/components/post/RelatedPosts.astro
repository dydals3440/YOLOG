---
import { Image } from "astro:assets";

import { getPost, getPosts } from "@/apis/posts";
import { excludePostId, type Post, PostPolicy } from "@/domains/post.model";
import { getPostPath } from "@/utils/routes";

interface Props {
  limit?: number | undefined;
}

const DEFAULT_LIMIT = 3;

const { limit = DEFAULT_LIMIT } = Astro.props;
const currentPost = await getPost(Astro.params.slug ?? "");
const now = new Date();
const relevanceTo = (basePost: Post) => (post: Post) =>
  PostPolicy.relevanceScore(post, basePost, now);
const relatedPosts = currentPost
  ? await getPosts({
      filters: [
        (post) => excludePostId(post, currentPost.id),
        (post) => relevanceTo(currentPost)(post) > 0,
      ],
      orderBy: relevanceTo(currentPost),
      limit,
    })
  : [];
---

{relatedPosts.length > 0 && (
  <section aria-labelledby="related-posts-title">
    <h2 id="related-posts-title" class="mb-6 text-sm font-medium text-second">
      관련 포스트
    </h2>
    <ul class="grid grid-cols-3 gap-5 max-lg:grid-cols-2 max-sm:grid-cols-1 max-sm:gap-4">
      {relatedPosts.map((post) => (
        <li>
          <a
            href={getPostPath(post.id)}
            class="min-w-0 rounded-lg no-underline focus-visible:outline-offset-[5px] max-sm:flex max-sm:items-center max-sm:gap-4"
          >
            <div class="aspect-video overflow-hidden rounded-lg border border-border bg-gray-100 max-sm:w-28 max-sm:shrink-0">
              {post.cover ? (
                <Image src={post.cover} alt="" width={640} class="size-full object-contain" />
              ) : (
                <div
                  class="flex h-full items-center justify-center text-xs text-second"
                  aria-hidden="true"
                >
                  이미지 없음
                </div>
              )}
            </div>
            <h3 class="mt-3 line-clamp-2 text-sm leading-relaxed font-medium break-keep text-heading max-sm:mt-0">
              {post.title}
            </h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

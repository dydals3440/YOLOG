---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  label: string;
  platform: string;
}

const { href, label, platform, class: className, ...props } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
  data-share-platform={platform}
  class:list={[
    "rounded-lg p-2 text-third transition-colors duration-200 hover:bg-hover hover:text-primary",
    className,
  ]}
  {...props}
>
  <slot />
</a>

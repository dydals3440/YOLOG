---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  direction: string;
  title: string;
}

const { href, direction, title, class: className, ...props } = Astro.props;
---

<a
  href={href}
  aria-label={`${direction}: ${title}`}
  class:list={["group flex flex-col gap-1", className]}
  {...props}
>
  <span class="text-disabled transition-colors group-hover:text-second">{direction}</span>
  <span class="-mx-1 rounded px-1 text-second transition-colors group-hover:bg-selection group-hover:text-heading">
    {title}
  </span>
</a>

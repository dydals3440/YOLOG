---
import VercelAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { PUBLIC_GA_ID } from "astro:env/client";
import { VERCEL_ENV } from "astro:env/server";

import { SITE } from "@/constants/site";
import { isProductionDeployment } from "@/utils/deployment";

interface Props {
  contentGroup?: string | undefined;
}

const GA_ID_PATTERN = /^G-[A-Z0-9]+$/;
const PLACEHOLDER_GA_ID = "G-XXXXXXXXXX";
const ADSENSE_CLIENT = "ca-pub-3296643559689345";
// 무료 플랜 한도(30일 10,000 이벤트) 안에서 실사용자 지표를 모은다.
const SPEED_INSIGHTS_SAMPLE_RATE = 0.5;

const { contentGroup = "사이트" } = Astro.props;
const isProduction = isProductionDeployment({
  isProductionBuild: import.meta.env.PROD,
  vercelEnvironment: VERCEL_ENV,
});
const gaId = PUBLIC_GA_ID?.trim() ?? "";
const hasGaId = GA_ID_PATTERN.test(gaId) && gaId !== PLACEHOLDER_GA_ID;
const hostname = new URL(SITE.url).hostname;
const adsenseSrc = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`;
---

{isProduction && hasGaId && <script
  id="yolog-ga"
  is:inline
  define:vars={{ gaId, hostname, contentGroup }}
>
  // 로컬 preview와 임의의 복제 도메인에서는 운영 통계를 수집하지 않는다.
  if (location.hostname === hostname && !window.gtag) {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
    const pageUrl = new URL(location.href);
    pageUrl.hash = "";
    // 유입 분석에 쓰는 값만 남기고 임의의 query 값은 수집하지 않는다.
    for (const key of Array.from(pageUrl.searchParams.keys())) {
      if (!/^(utm_(source|medium|campaign|id|term|content)|gclid|dclid|gbraid|wbraid)$/.test(key)) {
        pageUrl.searchParams.delete(key);
      }
    }
    window.gtag("js", new Date());
    window.gtag("config", gaId, { page_location: pageUrl.href, content_group: contentGroup });
    const script = document.createElement("script");
    script.async = true;
    script.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
    document.head.appendChild(script);
  }
</script>}
{isProduction && <script is:inline async src={adsenseSrc} crossorigin="anonymous" data-yolog-ads />}
{isProduction && <VercelAnalytics />}
{isProduction && <SpeedInsights sampleRate={SPEED_INSIGHTS_SAMPLE_RATE} />}

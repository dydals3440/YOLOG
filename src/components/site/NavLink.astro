---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  external?: boolean | undefined;
}

const { href, external = false, class: className, ...props } = Astro.props;
const currentSection = `/${Astro.url.pathname.split("/").at(1) ?? ""}`;
const isCurrent = !external && currentSection === href;
---

<a
  href={href}
  class:list={[
    "inline-block text-second no-underline transition-colors hover:text-heading",
    isCurrent && "font-bold text-heading",
    className,
  ]}
  aria-current={isCurrent ? "page" : undefined}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  {...props}
>
  <slot />
</a>

---
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href?: string | undefined;
  label: string;
  current?: boolean | undefined;
}

const { href, label, current = false, class: className, ...props } = Astro.props;
---

{href ? (
  <a href={href} aria-label={label} class:list={["page-link", className]} {...props}>
    <slot />
  </a>
) : (
  <span
    class:list={["page-link", current ? "is-current" : "is-disabled", className]}
    aria-current={current ? "page" : undefined}
    aria-hidden={current ? undefined : "true"}
  >
    <slot />
  </span>
)}

<style>
  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--text-second);
    text-decoration: none;
    border-radius: 10px;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 150ms ease;
  }

  a.page-link:hover {
    color: var(--heading);
    background-color: color-mix(in oklch, var(--gray-100) 80%, transparent);
  }

  a.page-link:active {
    transform: scale(0.96);
  }

  .page-link.is-current {
    color: var(--page-background);
    cursor: default;
    background-color: var(--heading);
  }

  .page-link.is-disabled {
    color: var(--text-disabled);
    cursor: not-allowed;
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    .page-link {
      min-width: 2.25rem;
      height: 2.25rem;
      padding: 0 0.375rem;
      border-radius: 8px;
    }
  }
</style>

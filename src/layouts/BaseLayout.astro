---
import "@/styles/global.css";
import "@/styles/animation.css";
import Analytics from "@/components/site/Analytics.astro";
import SeoHead, { type Props as SeoHeadProps } from "@/components/site/SeoHead.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";

interface Props {
  seo?: SeoHeadProps | undefined;
  class?: string | undefined;
}

const { seo = {}, class: className } = Astro.props;
---

<html lang="ko">
  <head>
    <SeoHead {...seo} />
    <Analytics contentGroup={seo.article?.section} />
  </head>
  <body>
    <SiteHeader />
    <main class={className}>
      <div class="main-container container mx-auto max-w-content pt-page">
        <slot />
      </div>
    </main>
    <SiteFooter />
    <p class="sr-only" aria-live="polite" data-copy-status></p>
  </body>
</html>

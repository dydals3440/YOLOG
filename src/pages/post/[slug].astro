---
import "@/styles/mdx.css";
import { ArrowLeft } from "@lucide/astro";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getImage } from "astro:assets";

import { getPosts, renderPost } from "@/apis/posts";
import Comments from "@/components/post/Comments.astro";
import ImageZoom from "@/components/post/ImageZoom.astro";
import PostActions from "@/components/post/PostActions.astro";
import PostHeader from "@/components/post/PostHeader.astro";
import PostImage from "@/components/post/PostImage.astro";
import PostNavigation from "@/components/post/PostNavigation.astro";
import PostTable from "@/components/post/PostTable.astro";
import ReadingProgress from "@/components/post/ReadingProgress.astro";
import RelatedPosts from "@/components/post/RelatedPosts.astro";
import TableOfContents from "@/components/post/TableOfContents.astro";
import { CATEGORY_LABEL } from "@/domains/category.model";
import { PostPolicy } from "@/domains/post.model";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toKstDateTime } from "@/utils/date";
import { getLargestCropSize } from "@/utils/image";
import { getPostMarkdownPath } from "@/utils/routes";
import { buildBlogPostingSchema, buildBreadcrumbSchema } from "@/utils/structured-data";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props;
const { Content, headings } = await renderPost(post.id);
const summary = PostPolicy.summary(post);
// Google 권장대로 16:9·4:3·1:1 대표 이미지를 만들고, 공유 미리보기는 1200px 원본 비율을 쓴다.
const STRUCTURED_DATA_ASPECT_RATIOS = [16 / 9, 4 / 3, 1];
const OG_IMAGE_WIDTH = 1200;

const cover = post.cover;
const ogImage = cover
  ? await getImage({ src: cover, width: Math.min(OG_IMAGE_WIDTH, cover.width) })
  : null;
const structuredDataImages = cover
  ? await Promise.all(
      STRUCTURED_DATA_ASPECT_RATIOS.map((ratio) =>
        getImage({ src: cover, ...getLargestCropSize(cover, ratio), fit: "cover" }),
      ),
    )
  : [];
---

<BaseLayout
  seo={{
    title: post.title,
    description: summary,
    image: ogImage?.src,
    article: {
      publishedTime: toKstDateTime(post.publishedAt),
      modifiedTime: toKstDateTime(post.updatedAt),
      section: CATEGORY_LABEL[post.category],
      tags: post.tags,
    },
    alternateMarkdownUrl: getPostMarkdownPath(post.id),
    schemas: [
      buildBlogPostingSchema({
        post,
        description: summary,
        images: structuredDataImages.map(({ src }) => src),
      }),
      buildBreadcrumbSchema(post),
    ],
  }}
>
  <ReadingProgress />

  <!-- 넓은 화면: 본문 칸 왼쪽 바깥에 사이드바 칸을 두고 따라 내려온다. 좁은 화면: 본문 위 한 줄. -->
  <div class="sidebar:-ml-56 sidebar:grid sidebar:grid-cols-[12.5rem_minmax(0,1fr)] sidebar:gap-x-6">
    <aside
      class="relative -top-6 mb-7 -ml-2 flex items-center justify-between pl-2 sidebar:sticky sidebar:top-[calc(var(--page-top)+3.75rem)] sidebar:mb-0 sidebar:ml-0 sidebar:max-h-[calc(100dvh-var(--page-top)-5rem)] sidebar:flex-col sidebar:items-stretch sidebar:justify-start sidebar:self-start sidebar:overflow-y-auto sidebar:px-2"
      data-animate
    >
      <a
        href="/blogs"
        class="group flex w-fit items-center gap-2 text-third transition-colors hover:text-primary sidebar:gap-1.5"
        data-post-back
      >
        <ArrowLeft
          class="size-4 transition-transform group-hover:-translate-x-0.5"
          stroke-width={2}
          aria-hidden="true"
        />
        <span class="text-sm">뒤로</span>
      </a>
      <div class="mt-6 hidden sidebar:block">
        <TableOfContents headings={headings} />
      </div>
      <div class="sidebar:pt-6">
        <PostActions />
      </div>
    </aside>

    <div class="min-w-0">
      <PostHeader post={post} />

      <article data-post-id={post.id} class="mdx">
        <Content components={{ img: PostImage, table: PostTable }} />
      </article>

      <div class="mt-16 border-t border-border pt-8 empty:hidden">
        <RelatedPosts />
      </div>

      <footer>
        <hr class="my-8 border-border" />
        <PostNavigation />
        <div class="mx-auto my-half-page">
          <Comments />
        </div>
      </footer>
    </div>
  </div>

  <ImageZoom />
</BaseLayout>

<script>
  import { setupMermaidReadability } from "@/components/post/mermaid-readability";
  import { setupPostNavigation } from "@/components/post/section-navigation";

  setupPostNavigation();
  setupMermaidReadability();
</script>

---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import { getPosts } from "@/apis/posts";
import YongGlass from "@/assets/yong-glass.svg";
import CategoryNav from "@/components/post/CategoryNav.astro";
import PostList from "@/components/post/PostList.astro";
import Pagination from "@/components/site/Pagination.astro";
import { CATEGORIES, CATEGORY_LABEL } from "@/domains/category.model";
import { filterByCategory } from "@/domains/post.model";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { toCategorySlug } from "@/utils/routes";

export const getStaticPaths = (async ({ paginate }) => {
  const POSTS_PER_PAGE = 5;
  const categoryPages = await Promise.all(
    CATEGORIES.map(async (category) => {
      const posts = await getPosts({ filters: [(post) => filterByCategory(post, category)] });
      return paginate(posts, {
        pageSize: POSTS_PER_PAGE,
        params: { category: toCategorySlug(category) },
        props: { category },
      });
    }),
  );
  return categoryPages.flat();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, category } = Astro.props;
const categoryLabel = CATEGORY_LABEL[category];
const pageSuffix = page.currentPage > 1 ? ` (${page.currentPage}페이지)` : "";
const toAbsoluteUrl = (path: string | undefined) =>
  path ? new URL(path, Astro.site).href : undefined;
---

<BaseLayout
  seo={{
    title: `${categoryLabel}${pageSuffix}`,
    description: `${categoryLabel} 카테고리 글 ${page.total}개`,
    prevUrl: toAbsoluteUrl(page.url.prev),
    nextUrl: toAbsoluteUrl(page.url.next),
  }}
>
  <div class="py-12 max-sm:py-8">
    <hgroup class="mb-12 max-sm:mb-8">
      <h1 class="mb-2 text-3xl font-bold tracking-tight max-sm:text-2xl">{categoryLabel}</h1>
      <p class="text-sm text-second">{page.total}개의 글</p>
    </hgroup>

    <div class="mb-10 max-sm:mb-8">
      <CategoryNav />
    </div>

    <PostList posts={page.data}>
      <div slot="empty" class="flex flex-col items-center justify-center py-16 text-center">
        <YongGlass class="mb-6" aria-hidden="true" />
        <p class="text-second">해당하는 게시글이 없어요.</p>
      </div>
    </PostList>

    {page.lastPage > 1 && (
      <div class="mt-12">
        <Pagination page={page} />
      </div>
    )}
  </div>
</BaseLayout>

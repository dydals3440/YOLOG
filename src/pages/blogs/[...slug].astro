---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

import BlogList from "@/components/blogs/BlogList.astro";
import CategoryList from "@/components/blogs/CategoryList.astro";
import Pagination from "@/components/blogs/Pagination.astro";
import YongGlass from "@/components/YongGlass.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buildBlogListingPaths } from "@/lib/blog-paths";
import { getSiteUrl } from "@/lib/config";
import { getPaginationUrls } from "@/lib/pagination-urls";

export const getStaticPaths = buildBlogListingPaths satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { posts, pagination, categories, category, categoryLabel } = Astro.props as Props;
const { totalPosts } = pagination;
const basePath = category ? `/blogs/${category}` : "/blogs";
const displayTitle = category ? categoryLabel : "전체";
const { prevUrl, nextUrl } = getPaginationUrls({
  category,
  currentPage: pagination.currentPage,
  totalPages: pagination.totalPages,
  siteUrl: getSiteUrl(Astro.site),
});

const baseTitle = category ? categoryLabel : "블로그";
const seoTitle =
  pagination.currentPage > 1 ? `${baseTitle} (${pagination.currentPage}페이지)` : baseTitle;
const seoDescription = category
  ? `${categoryLabel} 카테고리 글 ${totalPosts}개`
  : `개발자 매튜의 글 모음 — 개발/HTTP/디자인 패턴/회고/이야기 (총 ${totalPosts}개)`;
---

<BaseLayout seo={{ title: seoTitle, description: seoDescription, prevUrl, nextUrl }}>
  <div class="py-12 sm:py-8">
    <div class="mb-12 sm:mb-8">
      <h1 class="mb-2 text-3xl font-bold tracking-tight sm:text-2xl">{displayTitle}</h1>
      <p class="text-sm text-second">{totalPosts}개의 글</p>
    </div>

    <div class="mb-10 sm:mb-8">
      <CategoryList categories={categories} currentPath={Astro.url.pathname} />
    </div>

    {posts.length > 0 ? (
      <div>
        <BlogList posts={posts} />

        {pagination.totalPages > 1 && (
          <div class="mt-12">
            <Pagination pagination={pagination} basePath={basePath} />
          </div>
        )}
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center py-16 text-center">
        <YongGlass className="mb-6 h-24 w-24" />
        <p class="text-second">해당하는 게시글이 없습니다.</p>
      </div>
    )}
  </div>
</BaseLayout>
